/*

# Allow specific files in root
!/.gitignore
!/main.py
!/Makefile
!/pyproject.toml
!/README.md
!/requirements.txt
!/s2s.py
!/s2s.spec
!/STRUCTURE.md
!/VERSION

# Allow directories
!/.github/
!/.github/**
!/docs/
!/docs/**
!/scripts/
!/scripts/**
!/src/
!/src/**
!/storyboards/
!/storyboards/**
!/tests/
!/tests/**

# Build artifacts
/build/
/dist/
*.spec.bak
*.pyc
__pycache__/
*.egg-info/
.cache/

# Python cache
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.Python

# Test and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Linter and type checker caches
.mypy_cache/
.ruff_cache/
.pytype/

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Environment and local configs
.env
.env.local
*.local

# User-specific files
*.log
*.tmp
